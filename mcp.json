{
  "mcpServers": {
    "cartquant": {
      "command": "node",
      "args": ["dist/index.js"],
      "env": {
        "NODE_ENV": "production",
        "PORT": "3000",
        "MCP_URL": "http://localhost:3000"
      }
    },
    "trader-joes-scraper": {
      "command": "node",
      "args": ["dist/src/mcp-servers/traderjoes/server.js"],
      "env": {
        "NODE_ENV": "production",
        "PORT": "3001",
        "MCP_URL": "http://localhost:3001"
      }
    }
  }
}
